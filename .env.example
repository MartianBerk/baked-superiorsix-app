# Used by docker compose (and later local API wiring).
# Sibling docker compose publishes: auth 8010, user 8020, superiorsix 8030.
# Local poetry processes often listen on 8000 / 8001 / … instead.

AUTH_UPSTREAM=http://127.0.0.1:8010
USER_UPSTREAM=http://127.0.0.1:8020
SUPERSIX_UPSTREAM=http://127.0.0.1:8030
