# Copy to .env for local Expo (npx expo start). Never commit .env.
#
# Primary: APIs from baked-superiorsix/local-dev on the host-published ports.
#   auth 8010 · user 8020 · superiorsix 8030
#
# See baked-superiorsix/local-dev/README.md for bootstrap + invite notes.

EXPO_PUBLIC_AUTH_URL=http://127.0.0.1:8010
EXPO_PUBLIC_USER_URL=http://127.0.0.1:8020
EXPO_PUBLIC_SUPERSIX_URL=http://127.0.0.1:8030

# Euros player-tab mock fixtures (matches/scores). Default on in __DEV__;
# set to 0 to force live APIs, or 1 to force mock outside DEV.
# EXPO_PUBLIC_EUROS_MOCK=1

# Optional: talk through this repo's Docker nginx (:8040) with same-origin
# paths after a `npm run build:web` that baked those bases in:
# EXPO_PUBLIC_AUTH_URL=/auth
# EXPO_PUBLIC_USER_URL=/user
# EXPO_PUBLIC_SUPERSIX_URL=/superiorsix

# Used only by this repo's docker compose (nginx upstreams → host-published APIs).
# Host Expo ignores these.
AUTH_UPSTREAM=http://host.docker.internal:8010
USER_UPSTREAM=http://host.docker.internal:8020
SUPERSIX_UPSTREAM=http://host.docker.internal:8030
