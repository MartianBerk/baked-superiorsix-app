# Copy to .env for local Expo (npx expo start). Never commit .env.
#
# Primary: APIs from baked-devops/local-dev on the host-published ports.
#   auth 8010 · user 8020 · superiorsix 8030
#
# See baked-devops/local-dev/README.md for bootstrap + invite notes.

EXPO_PUBLIC_AUTH_URL=http://127.0.0.1:8010
EXPO_PUBLIC_USER_URL=http://127.0.0.1:8020
EXPO_PUBLIC_SUPERSIX_URL=http://127.0.0.1:8030

# Optional: talk through the Docker nginx web UI (profile `app` on :8040)
# instead of hitting the API ports directly. Same-origin paths after a
# `npm run build:web` that baked those bases in:
# EXPO_PUBLIC_AUTH_URL=/auth
# EXPO_PUBLIC_USER_URL=/user
# EXPO_PUBLIC_SUPERSIX_URL=/superiorsix

# Used only by this repo's docker compose / the local-dev `app` profile
# (nginx upstreams). Host Expo ignores these.
AUTH_UPSTREAM=http://127.0.0.1:8010
USER_UPSTREAM=http://127.0.0.1:8020
SUPERSIX_UPSTREAM=http://127.0.0.1:8030
